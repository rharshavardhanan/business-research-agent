# --- Search provider ------------------------------------------------------
# osm            free, no key, no billing. Coverage is thin: in Chennai, most
#                clinics have no phone or website tag, which also means website
#                enrichment (and therefore doctor names) has nothing to read.
# google_places  far richer data. Needs a key AND a billing-enabled GCP project.
SEARCH_PROVIDER=osm

# --- Required -------------------------------------------------------------
# Command parsing is LLM-only by design and has no fallback. Without this,
# POST /command returns a 400 explaining what to set.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# NOT 3.5-flash: measured on a real free key, gemini-3.5-flash caps at 20
# requests PER DAY, i.e. twenty typed commands and you are done until tomorrow.
# gemini-2.5-flash has usable free headroom and parses these commands identically.
GEMINI_MODEL=gemini-2.5-flash

# --- Only when SEARCH_PROVIDER=google_places ------------------------------
# https://console.cloud.google.com/ -> enable "Places API (New)" -> credentials.
GOOGLE_PLACES_API_KEY=

# --- Paths ----------------------------------------------------------------
DATA_DIR=data

# --- Deployment only ------------------------------------------------------
# Leave BLANK for local use. Set it before exposing the app to a network:
# every route spends billable Google quota and can read or delete your leads.
APP_PASSWORD=
APP_USERNAME=admin
